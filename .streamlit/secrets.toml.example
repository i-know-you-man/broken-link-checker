# ตัวอย่างการตั้งค่า Secrets สำหรับ Streamlit Cloud (หรือไฟล์ .streamlit/secrets.toml ในเครื่อง)
# ห้าม commit ไฟล์ .streamlit/secrets.toml ที่มีรหัสจริงขึ้น GitHub (ถูกกันไว้ใน .gitignore แล้ว)

# ---------------------------------------------------------------------------
# (ไม่บังคับ) รหัสผ่านเข้าใช้งานหน้าเว็บ
# ---------------------------------------------------------------------------
# APP_PASSWORD = "ตั้งรหัสผ่านของคุณที่นี่"

# ---------------------------------------------------------------------------
# วิธีที่ 1 (แนะนำ — ง่ายสุด ไม่ต้องใช้ Google Cloud): Google Apps Script Webhook
# ---------------------------------------------------------------------------
# 1. สร้าง Google Sheet -> Extensions -> Apps Script -> วางโค้ดจากไฟล์ google_apps_script.gs
# 2. Deploy -> New deployment -> Web app (Execute as: Me, Who has access: Anyone)
# 3. นำ Web app URL ที่ลงท้ายด้วย /exec มาใส่ด้านล่าง:
GSHEET_WEBHOOK_URL = "https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# (ไม่บังคับ) ถ้าตั้ง SECRET_TOKEN ใน Apps Script ให้ใส่ให้ตรงกันที่นี่:
# GSHEET_WEBHOOK_TOKEN = "my-secret-token"

# (ไม่บังคับ) ลิงก์ Google Sheet สำหรับแสดงปุ่มกดเปิดดูชีตโดยตรงจากหน้าเว็บ:
# GSHEET_URL = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"

# ---------------------------------------------------------------------------
# วิธีที่ 2 (ทางเลือก): Google Cloud Service Account (gspread)
# หากใช้วิธีนี้ ให้ใส่ URL ของ Sheet และข้อมูล JSON Key ด้านล่างแทนวิธีที่ 1
# ---------------------------------------------------------------------------
# GSHEET_URL = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"
# GSHEET_WORKSHEET = "Scan_History"
#
# [gcp_service_account]
# type = "service_account"
# project_id = "your-project-id"
# private_key_id = "your-key-id"
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "your-service-account@your-project-id.iam.gserviceaccount.com"
# client_id = "1234567890"
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/..."
